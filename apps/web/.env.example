# LaMa ONNX tự host cho Xóa đồ (D11) — tùy chọn, mặc định .models/lama_fp32.onnx (cwd apps/web).
# Tải model bằng `pnpm --filter web fetch:lama`. Chỉ đổi nếu đặt model ở nơi khác.
LAMA_MODEL_PATH=

# Service GeoCalib đoán tầm mắt (services/calibrate) — tùy chọn, mặc định http://127.0.0.1:8001.
CALIBRATE_URL=
